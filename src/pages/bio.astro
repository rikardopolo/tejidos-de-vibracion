---
/**
 * /bio · página de enlaces para la biografía de Instagram y TikTok.
 *
 * Sin esto, el enlace-puente no arregla nada en las dos plataformas donde más
 * se publica: la bio admite UN solo enlace, así que no puede llevar un
 * `utm_content` distinto por pieza. Esta página es ese enlace único, y desde
 * ella cada pieza sale por su `/r/<slug>`, que sí sella su campaña.
 *
 * Deliberadamente austera: sin JS propio, sin imágenes pesadas, sin iconos de
 * terceros. Se abre dentro del navegador embebido de Instagram, que es lento y
 * hostil; cada kilobyte se paga en abandono.
 *
 * `robots="noindex"` — no debe competir en buscadores con la Obertura ni con
 * el portal. Es infraestructura, no contenido.
 */
import Base from '@/layouts/Base.astro';
import BookFooter from '@/components/BookFooter.astro';
import { PIEZAS, ORDEN_BIO } from '@/lib/piezas';

const enlaces = ORDEN_BIO.map((slug) => ({ slug, ...PIEZAS[slug] })).filter((e) => e.destino);
---

<Base
  title="Enlaces · Tejidos de Vibración"
  description="Todo lo que se menciona en las publicaciones: la Obertura del libro, los simuladores del laboratorio y las piezas recientes."
  pageId="bio"
  robots="noindex, follow"
>
  <main id="main-content" tabindex="-1" class="bio">
    <header class="bio__head">
      <p class="eyebrow">Tejidos de Vibración</p>
      <h1 class="bio__title">Lo que se menciona en las publicaciones</h1>
    </header>

    <nav class="bio__lista" aria-label="Enlaces de las publicaciones">
      {enlaces.map((e) => (
        <a class="bio__enlace" href={`/r/${e.slug}`} rel="noopener">
          <span class="bio__enlace-titulo">{e.titulo ?? e.slug}</span>
        </a>
      ))}
    </nav>

    <p class="bio__nota">
      La Obertura completa es gratuita. No hace falta registrarse para leerla.
    </p>
  </main>

  <BookFooter />
</Base>

<style>
  /* Estilos locales: la página vive dentro del navegador de Instagram, donde
     no conviene depender de nada global que pueda no haber cargado. */
  .bio {
    max-width: 34rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 1rem;
  }
  .bio__head {
    text-align: center;
    margin-bottom: 2rem;
  }
  .bio__title {
    font-family: var(--serif, Georgia, serif);
    font-style: italic;
    font-size: clamp(1.5rem, 5vw, 2rem);
    line-height: 1.25;
    margin: 0.35rem 0 0;
  }
  .bio__lista {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .bio__enlace {
    display: block;
    padding: 1rem 1.15rem;
    border: 1px solid var(--linea, rgba(212, 160, 23, 0.28));
    border-radius: 0.5rem;
    text-decoration: none;
    color: inherit;
    /* Área de pulsación cómoda: casi todo el tráfico es móvil y dentro de un
       navegador embebido, donde fallar el toque es abandono. */
    min-height: 3rem;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .bio__enlace:hover,
  .bio__enlace:focus-visible {
    border-color: var(--oro, #d4a017);
    transform: translateY(-1px);
  }
  .bio__enlace-titulo {
    font-size: 1.02rem;
    line-height: 1.35;
  }
  .bio__nota {
    margin-top: 2rem;
    text-align: center;
    font-size: 0.9rem;
    opacity: 0.72;
  }
  @media (prefers-reduced-motion: reduce) {
    .bio__enlace { transition: none; }
    .bio__enlace:hover, .bio__enlace:focus-visible { transform: none; }
  }
</style>

# Brevo (lead capture libro · Double Opt-In)
BREVO_API_KEY=
BREVO_LISTA_LIBRO=
BREVO_TEMPLATE_DOI=
BREVO_TEMPLATE_BIENVENIDA=
# Email de acceso tras compra (Fase 4). La plantilla debe tener click-tracking DESACTIVADO.
BREVO_TEMPLATE_BUNDLE_PREVENTA=

# Gating · tokens de acceso HMAC
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=

# Supabase · backbone UNIFICADO de seguimiento (MISMO proyecto que el portal TDR).
# Server-only: persiste el ciclo de vida del suscriptor (lead/confirmación) y la
# lectura del libro (reading_events / reading_progress). NO afecta la CSP (la CSP
# es de navegador; las llamadas servidor→Supabase ocurren fuera de él).
# Requiere haber aplicado supabase/migrations/20260602120000_subscriber_tracking.sql
# del repo tejidos-de-realidad sobre ese proyecto.
PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Sesión del libro · salto desde el portal (S-12 · plan v2 §7.4-7.5)
# Interruptor. Solo 'true' enciende /auth/{entrar,callback,salir,error}, el nivel 1
# por __Host-tdv_sesion y los enlaces «Entrar» / «Crear cuenta». Vacío o 'false' =
# apagado (reversión): /auth/* responde 404 y el gating no mira la sesión.
TDV_SESION_ENABLED=
# Firma __Host-tdv_sesion y __Host-tdv_state. Mínimo 32 caracteres; distinto por
# entorno y de tipo Sensitive en Vercel. NUNCA el mismo que el portal ni que
# ACCESS_TOKEN_SECRET. Sin él (o corto) el salto falla cerrado.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TDV_SESSION_SECRET=
# URL de autorización del portal, sin query (el libro añade ?aud=tdv&state=…).
# https obligatorio (http solo en localhost). En Preview, el alias de rama fijo del portal.
# p. ej. https://tejidosderealidad.com/cuenta/autorizar
PORTAL_AUTORIZAR_URL=

# Feature flags
GATING_ACTIVO=true
SUSCRIPCION_ACTIVA=false
COMUNIDAD_ACTIVA=false

# Site
PUBLIC_SITE_URL=https://tejidosdevibracion.com
SITE_URL=https://tejidosdevibracion.com

# Lemon Squeezy (checkout · Merchant of Record)
# El modo test/live lo determina la API key (test vs live).
# En Vercel: valor por environment → API key de TEST en Preview, LIVE en Production.
# (El variant_id también difiere test/live; el store_id es el mismo en ambos.)
LEMONSQUEEZY_API_KEY=
LS_STORE_ID=
# Variante → producto. El webhook decide producto y nivel por first_order_item.variant_id,
# NUNCA por custom_data.product_slug. Una variable por slug del catálogo
# (src/lib/product-slugs.mjs): LS_VARIANT_<SLUG en mayúsculas, con _ en vez de ->.
# Una variante sin variable cae en order_unknown_product (sin acceso). Si dos slugs
# comparten id, esa variante tampoco da acceso (configuración ambigua).
# Al vender otro producto, añadir la suya (p. ej. LS_VARIANT_BUNDLE_NORMAL, LS_VARIANT_LIBRO_COMPLETO).
LS_VARIANT_BUNDLE_PREVENTA=
# Variantes de SUSCRIPCIÓN: toda variable que empiece por LS_VARIANT_SUSCRIPCION
# (p. ej. LS_VARIANT_SUSCRIPCION_MENSUAL=…). El camino de órdenes las ignora:
# evento order_suscripcion_ignorada, 200, sin orden one-time ni token.
# Signing secret del webhook de LS (Settings → Webhooks) · verifica la firma del raw body.
LS_WEBHOOK_SECRET=
# Solo Preview. 'true' = procesar los eventos con meta.test_mode=true. Vacío = ignorarlos
# (200 + evento test_mode_ignorado, nada más). Con VERCEL_ENV=production se ignora
# aunque esté puesta: nunca crearla en Production.
LS_ACEPTAR_TEST_MODE=

# Sentry · observabilidad de errores (SOLO server-side: /api/* + rutas prerender=false).
# DSN del proyecto Sentry (tdv-libro) · lo lee sentry.server.config.js vía process.env
# (fuente de verdad = dashboard de Vercel). Sin prefijo PUBLIC_: el navegador nunca
# llama a Sentry (SDK cliente desactivado → CSP intacta). Vacío = desactivado.
SENTRY_DSN=

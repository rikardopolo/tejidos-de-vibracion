---
/**
 * /indice · Tabla de contenidos del Volumen I
 * Mirrors handoff indice.html design.
 * Caps. I–III se cargan desde la colección `book`;
 * Caps. IV–X están hardcoded (en gestación, sin MDX aún).
 */
import { getCollection } from 'astro:content';
import LecturaLarga from '@/layouts/LecturaLarga.astro';
import TocEntry from '@/components/book/TocEntry.astro';
import LitLink from '@/components/book/LitLink.astro';

// Slug → href map for published chapters
const SLUG_MAP: Record<number, string> = {
  1: '/capitulo/cap-1-universo-sinfonia',
  2: '/capitulo/cap-2-ciencia-escuchar',
  3: '/capitulo/cap-3-mundo-cuantico',
  4: '/capitulo/cap-4-biologia-campo-coherente',
};

// Acto I · el estado
// (soon vs abierto) NO vive aquí: se deriva del frontmatter `status` de cada
// MDX más abajo, la misma fuente única que gobierna el gating y el sitemap.
const ACTO_I = [
  { n: 1, roman: 'I' },
  { n: 2, roman: 'II' },
  { n: 3, roman: 'III' },
];

// Load chapters visibles en el índice · 'published' renderiza contenido,
// 'fragmento-permanente' renderiza BloquePuerta 'espera' (mismo runtime
// behavior que un cap N1 no publicado · ver capitulo/[slug].astro).
const allChapters = await getCollection('book', ({ data }) =>
  data.kind === 'capitulo' &&
  (data.status === 'published' || data.status === 'fragmento-permanente')
);
const publishedByNumber = new Map(
  allChapters.map((e) => [e.data.chapter as number, e.data])
);

// Capítulos SIN MDX todavía · el título y el subtítulo viven aquí porque no hay
// frontmatter del que sacarlos. Los que SÍ tienen MDX se derivan de él (ver el
// map de más abajo): el Cap. 4 ya tiene sus 12 piezas escritas, así que su
// entrada sirve sólo de reserva por si su MDX no está en la colección.
const gestatingChapters = [
  { num: 4, roman: 'IV', title: 'La biología del campo coherente', subtitle: 'Corazón, células y los ritmos que el cuerpo comparte con el mundo' },
  { num: 5, roman: 'V',  title: 'Neurociencia de la frecuencia',  subtitle: 'Ondas cerebrales, atención y el cerebro como instrumento' },
  { num: 6, roman: 'VI', title: 'Estados expandidos de consciencia', subtitle: 'Lo que ocurre cuando la red por defecto se silencia' },
  { num: 7, roman: 'VII',  title: 'El problema del observador',   subtitle: 'Por qué la consciencia no se deja medir desde afuera' },
  { num: 8, roman: 'VIII', title: 'El campo relacional',          subtitle: 'Lo que ocurre entre dos consciencias atentas' },
  { num: 9, roman: 'IX',   title: 'Filosofía de la ciencia vibracional', subtitle: 'Los límites del lenguaje científico ante la experiencia' },
  { num: 10, roman: 'X',  title: 'El tejedor consciente',         subtitle: 'Vivir como si la mirada importara, porque importa' },
];

// Entradas del Acto II · resueltas AQUÍ y no en el template porque un `>=` dentro
// de un bloque JSX de Astro se parsea como cierre de etiqueta (ts(1382)).
//
// Mismo mecanismo que el Acto I: el estado se DERIVA del frontmatter del MDX, que
// es la fuente única que gobierna también el gating y el sitemap.
// `publishedByNumber` sólo admite 'published' o 'fragmento-permanente', así que un
// capítulo en 'draft' —el Cap. 4 en main— cae a gestación y sigue sin enlace; en un
// preview con el capítulo abierto, aparece navegable.
//
// El Acto II se abre con la suscripción según el modelo de acceso del 19-oct.
const ACTO_II = gestatingChapters
  .filter((c) => c.num >= 4 && c.num <= 6)
  .map((c) => {
    const data = publishedByNumber.get(c.num);
    if (!data) {
      return { roman: c.roman, title: c.title, subtitle: c.subtitle, access: 'Con la suscripción · En preparación', gestating: true } as const;
    }
    const soon = data.status !== 'published';
    return {
      roman: c.roman,
      title: data.title,
      subtitle: data.subtitle ?? c.subtitle,
      href: SLUG_MAP[c.num],
      access: soon ? 'Con la suscripción · En preparación' : 'Con la suscripción',
      soon,
      gestating: false,
    };
  });
---

<LecturaLarga
  robots="index,follow"
  title="Índice · Volumen I · Tejidos de Vibración"
  description="Índice del Volumen I de Tejidos de Vibración. Tres actos, diez capítulos sobre la física vibracional, la biología del campo coherente y la consciencia."
  pageId="indice"
>
  <article class="measure pt-5">
    <header>
      <h1 class="title-1">Índice</h1>
      <p class="meta">Volumen I · Tejidos de Vibración</p>
    </header>

    <p style="font-family: var(--serif); font-style: italic; font-size: 1.0625rem; line-height: 1.6; color: var(--tinta-suave); max-width: 36rem; margin: 1.5rem 0 0;">La Obertura y los capítulos I–III son libres con tu cuenta de Tejidos de Realidad. Desde el capítulo IV, las entregas publicadas se abren con la suscripción Acceso al Tejedor. Las piezas en preparación se publican a medida que están listas.</p>

    <!-- Obertura -->
    <TocEntry
      num="—"
      access="Libre con tu cuenta"
      title="Obertura"
      subtitle="El tejedor consciente despierta"
      href="/obertura"
    />

    <!-- Acto I · Fundamentos -->
    <section class="toc-act">
      <p class="toc-act__cue">Acto I</p>
      <h2 class="toc-act__title">
        Fundamentos<span class="toc-act__title-tail">La vibración primordial</span>
      </h2>

      {/*
        Estados del Acto I DERIVADOS del frontmatter `status` de cada MDX
        (fuente única de verdad · la misma que gobierna el gating runtime y el
        sitemap):
        - status 'fragmento-permanente' → soon=true · en preparación, sin fecha prometida
        - status 'published'            → soon=false · libre con tu cuenta · link activo
        Los caps IV-X siguen `gestating` (Acto II/III · pagos).

        Para ABRIR un capítulo del Acto I: cambiar SOLO su MDX a status:
        "published" (un edit) → /indice, el gating y el sitemap se actualizan
        juntos.
      */}
      {ACTO_I.map(({ n, roman }) => {
        const data = publishedByNumber.get(n);
        if (!data) return <TocEntry num={roman} title={`Capítulo ${roman}`} subtitle="" access="Libre con tu cuenta · En preparación" gestating />;
        const soon = data.status !== 'published';
        const access = soon ? 'Libre con tu cuenta · En preparación' : 'Libre con tu cuenta';
        return (
          <TocEntry
            num={roman}
            title={data.title}
            subtitle={data.subtitle ?? ''}
            href={SLUG_MAP[n]}
            access={access}
            soon={soon}
          />
        );
      })}
    </section>

    <!-- Acto II · Cuerpo -->
    <section class="toc-act">
      <p class="toc-act__cue">Acto II</p>
      <h2 class="toc-act__title">
        Cuerpo<span class="toc-act__title-tail">La biología que escucha</span>
      </h2>

      {/*
        Mismo mecanismo que el Acto I: el estado se DERIVA del frontmatter del
        MDX, no se declara aquí. `publishedByNumber` sólo contiene capítulos con
        status 'published' o 'fragmento-permanente', así que un capítulo en
        'draft' —como el Cap. 4 en main— cae al listado de gestación y sigue sin
        enlace. En un preview con el capítulo abierto, aparece navegable.

        Las entregas publicadas del Acto II se abren con la suscripción.
      */}
      {ACTO_II.map((e) => (
        <TocEntry
          num={e.roman}
          title={e.title}
          subtitle={e.subtitle}
          href={e.href}
          access={e.access}
          soon={e.soon}
          gestating={e.gestating}
        />
      ))}
    </section>

    <!-- Acto III · Tejedor -->
    <section class="toc-act">
      <p class="toc-act__cue">Acto III</p>
      <h2 class="toc-act__title">
        Tejedor<span class="toc-act__title-tail">La mirada que teje</span>
      </h2>

      {gestatingChapters.filter((c) => c.num >= 7).map((c) => (
        <TocEntry
          num={c.roman}
          title={c.title}
          subtitle={c.subtitle}
          access="Con la suscripción · En preparación"
          gestating
        />
      ))}
    </section>

    <!-- Aparato del libro -->
    <section class="mt-7">
      <p class="eyebrow">Aparato del libro</p>
      <!-- Numeración según el canon: Indice_Maestro_TDV_VolumenI_v5.md (§ Anexos).
           A · Glosario Técnico-Vivencial
           B · Constelación de Pensadores y Bibliografía Anotada
           C · Cuaderno de Prácticas Contemplativas
           D · Otras Lecturas del Cosmos Cuántico
           E · Errores Comunes de Divulgación Cuántica
           F · Matemáticas de la Vibración (opcional)
           El Laboratorio de Simuladores NO es un anexo del canon: va sin letra a propósito.
           Antes decía «Anexo C» (la Constelación) y «Anexo D» (el Laboratorio), que chocaban
           con la B y con «Otras Lecturas». Corregido el 26-ago-2026. -->
      <ul style="list-style: none; padding: 0; margin: 1.5rem 0 0 0; font-family: var(--serif); font-size: 1.0625rem; line-height: 2;">
        <li>
          <a href="https://tejidosderealidad.com/pensadores" class="lit-link-secondary" style="color: var(--tinta);">
            Anexo B · La Constelación de Pensadores
          </a>
          <span class="meta"> — vive en el portal hermano</span>
        </li>
        <li>
          <a href="https://tejidosderealidad.com/simuladores" class="lit-link-secondary" style="color: var(--tinta);">
            El Laboratorio de Simuladores
          </a>
          <span class="meta"> — vive en el portal hermano</span>
        </li>
        <li>
          <a href="/colofon" class="lit-link-secondary" style="color: var(--tinta);">
            Colofón · Linaje, herramientas y agradecimientos
          </a>
        </li>
      </ul>
    </section>

    <!-- CTA final -->
    <p class="center mt-6 mb-6">
      <LitLink href="/obertura">Empezar por la Obertura</LitLink>
    </p>

  </article>
</LecturaLarga>
